{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sr3h-ai-presence-checker",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "mcp.sr3h.uk",
      "custom_domain": true
    }
  ],
  "ratelimits": [
    {
      "name": "AUDIT_RATE_LIMITER",
      "namespace_id": "12001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "WEB_RATE_LIMITER",
      "namespace_id": "12002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
